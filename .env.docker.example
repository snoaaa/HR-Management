# Copy this file to ".env" (next to docker-compose.yml) and adapt it.
# Deployment address: https://agile.emakotech.cloud

# Long random text, kept secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# PostgreSQL (choose a strong password; avoid the characters @ : / # ? in it)
POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=

# Address of the application.
HRMS_DOMAIN=agile.emakotech.cloud
ALLOWED_HOSTS=agile.emakotech.cloud,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://agile.emakotech.cloud
# true when HTTPS is handled in front of the application (reverse proxy or the
# bundled Caddy). Set to false only for a plain http:// test on a local machine.
BEHIND_HTTPS_PROXY=true

# Port 8000 of the application on the server. Use HRMS_BIND=127.0.0.1 when a
# proxy on the same machine is the only thing that should reach it.
HRMS_BIND=0.0.0.0
HRMS_PORT=8000

# Sender of the e-mails.
DEFAULT_FROM_EMAIL=hrms@agile.emakotech.cloud

# true = create the demonstration accounts and data on the first start.
SEED_DEMO=false
